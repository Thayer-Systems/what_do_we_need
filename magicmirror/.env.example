# Copy to .env in this directory and fill in real values.
# .env is gitignored at the repo root already covers "*.env"? Verify before committing.

# Mr Sprinkles (Supabase) — read-only anon key, RLS-scoped
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# NyxOS (PocketBase) — superuser creds, used server-side only (node_helper.js),
# never sent to the browser
PB_URL=http://pocketbase:8090
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me

TZ=America/New_York
